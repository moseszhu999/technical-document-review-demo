{
  "schema": "public_demo_rule_catalog_v1",
  "note": "すべてのルールと数値は公開デモ用の架空データです。",
  "rules": [
    {
      "rule_id": "DEMO-R01",
      "title": "図面改訂番号の整合",
      "rule_type": "all_equal",
      "target_asset_id": "GBX-042",
      "public_rule": "組立図と検査記録が同じ図面改訂番号を参照していること",
      "inputs": [
        {"name": "drawing_revision", "document_type": "AssemblyDrawing", "field": "drawing_revision"},
        {"name": "inspection_revision", "document_type": "InspectionReport", "field": "drawing_revision"}
      ],
      "judgment": "2つの入力値が一致していれば適合。一致しなければ要確認。",
      "output": {
        "pass": "revision_consistent",
        "needs_review": "drawing_revision_mismatch"
      },
      "parameters": {},
      "evidence_requirements": ["組立図の改訂番号", "検査記録の改訂番号"],
      "human_review": true,
      "on_fail": "drawing_revision_mismatch"
    },
    {
      "rule_id": "DEMO-R02",
      "title": "減速比の確認",
      "rule_type": "relative_tolerance",
      "target_asset_id": "GEARSET-01",
      "public_rule": "設計値と実測値の差がデモ用許容差以内であること",
      "inputs": [
        {"name": "design", "document_type": "AssemblyDrawing", "field": "gear_ratio_design"},
        {"name": "measured", "document_type": "InspectionReport", "field": "gear_ratio_measured"}
      ],
      "judgment": "設計値と実測値の相対差を確認し、デモ用の許容差以内なら適合。",
      "output": {
        "pass": "ratio_within_demo_tolerance",
        "needs_review": "ratio_out_of_tolerance"
      },
      "parameters": {"max_relative_error_percent": 1.5},
      "evidence_requirements": ["設計減速比", "実測減速比"],
      "human_review": true,
      "on_fail": "ratio_out_of_tolerance"
    },
    {
      "rule_id": "DEMO-R03",
      "title": "ベアリングすきまの確認",
      "rule_type": "numeric_range",
      "target_asset_id": "BRG-01",
      "public_rule": "実測すきまがデモ用の下限・上限範囲内であること",
      "inputs": [
        {"name": "minimum", "document_type": "AssemblyDrawing", "field": "clearance_min_mm"},
        {"name": "maximum", "document_type": "AssemblyDrawing", "field": "clearance_max_mm"},
        {"name": "measured", "document_type": "InspectionReport", "field": "clearance_measured_mm"}
      ],
      "judgment": "実測値が下限以上かつ上限以下なら適合。範囲外なら要確認。",
      "output": {
        "pass": "clearance_within_demo_range",
        "needs_review": "clearance_out_of_range"
      },
      "parameters": {},
      "evidence_requirements": ["すきま下限", "すきま上限", "実測すきま"],
      "human_review": true,
      "on_fail": "clearance_out_of_range"
    }
  ]
}