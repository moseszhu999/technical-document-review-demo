APP_NAME="Technical Document Review Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=debug

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Volcengine Ark (server-side only; never commit real secrets)
# Agent Plan subscription key: use the plan endpoint + ark-code-latest.
# (A pay-as-you-go key would use https://ark.cn-beijing.volces.com/api/v3
# with a model such as doubao-seed-2.1-pro instead.)
# The plan model is a reasoning model: first token takes a few seconds and a
# full answer can take 30-60s, hence the 60s timeout.
ARK_API_KEY=
ARK_MODEL=ark-code-latest
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_TIMEOUT=60
